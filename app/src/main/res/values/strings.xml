<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">HyperDuo</string>
    <string name="xposed_description">把状态栏的 Wi-Fi、移动信号与电池合并为一个仿 iPhone Duo 的三合一体图标。</string>

    <string name="group_appearance">外观</string>
    <string name="group_geometry">尺寸</string>
    <string name="group_colors">颜色</string>

    <string name="group_stroke">描边</string>
    <string name="group_text">文字</string>
    <string name="group_type">网络类型</string>
    <string name="group_track">底纹</string>

    <string name="tab_general">常规</string>

    <string name="master_title">启用三合一图标</string>
    <string name="master_summary">总开关。关闭后恢复系统原本的电池与信号图标。</string>

    <string name="trio_style_title">三合一样式</string>
    <string name="trio_style_summary">选择三合一的排布方式。圆环是默认样式；矩形改用左右两列信号点夹住中间内容，底部横贯一条电量条。</string>
    <string name="trio_style_ring">圆环</string>
    <string name="trio_style_rect">矩形</string>

    <string name="overlay_title">独立窗口绘制</string>
    <string name="overlay_summary">把三合一画在一个独立的小窗口里，不再受状态栏窗口高度（约 43dp）限制，图标可以完整显示；代价是图形下半部分会露在状态栏背景之外。关闭后回到状态栏内绘制。</string>

    <string name="show_wifi_title">显示 Wi-Fi 弧</string>
    <string name="show_wifi_summary">在最外层绘制 Wi-Fi 弧线，弧数跟随实际信号强度；关闭后原生 Wi-Fi 图标回到状态栏原本的位置。</string>

    <string name="show_mobile_title">显示移动信号点</string>
    <string name="show_mobile_summary">在底部绘制四个电平点表示移动网络信号强度；关闭后原生移动信号图标回到状态栏原本的位置。</string>

    <string name="dual_sim_title">双卡信号</string>
    <string name="dual_sim_summary">无 Wi-Fi 且未充电时，改画上下两排信号点：上排为卡一，下排为卡二。只在双卡且能读到两卡电平时生效；单卡或正在充电时仍只画一排，显示当前上网卡。</string>

    <string name="show_value_title">显示电量数字</string>
    <string name="show_value_summary">在环内显示电量百分比；充电时改为闪电图标。关闭后充电闪电同样交还原生图标。</string>

    <string name="show_bolt_title">充电时显示闪电</string>
    <string name="show_bolt_summary">关闭后不再用环内闪电，改由系统原生的充电闪电显示在电池图标旁。</string>

    <string name="show_mobile_type_title">网络类型</string>
    <string name="show_mobile_type_summary">选择网络类型文字的显示位置：关闭、圆环内，或在状态栏中另外绘制一个。</string>
    <string name="mobile_type_off">关闭</string>
    <string name="mobile_type_inside">环内</string>
    <string name="mobile_type_outside">环外</string>

    <string name="signal_mode_title">信号位置</string>
    <string name="signal_mode_summary">选择移动信号读数的位置。环内沿用图标底部的电平点；环外则把它挪到电池图标旁，按下面的堆叠开关决定怎么显示。</string>
    <string name="signal_mode_inside">环内</string>
    <string name="signal_mode_outside">环外</string>

    <string name="stacked_signal_title">堆叠信号</string>
    <string name="stacked_signal_summary">环外时自己绘制读数：四条高度递增的柱表示一张卡，下方一排圆点表示另一张卡；只有一张卡时只画柱。关闭则沿用系统原生的移动信号图标。</string>

    <string name="data_sim_only_title">仅显示上网卡</string>
    <string name="data_sim_only_summary">双卡时只绘制当前上网卡的读数，另一张卡不显示。单卡或读不到上网卡时不受影响。</string>

    <string name="out_signal_size_title">环外信号大小</string>
    <string name="out_signal_size_summary">环外读数的整体高度，单位为 dp（会随屏幕密度自动换算成像素）。15dp 与状态栏原生信号图标同高，也是默认值；可调范围 6–20dp。无论有没有下方圆点排，同一行都按同一大小绘制，两种形状不会一大一小。下拉控制中心不会改变它。</string>

    <string name="out_signal_offset_x_title">环外信号水平位置</string>
    <string name="out_signal_offset_x_summary">环外读数在状态栏里左右移动的距离，单位为 dp，正数向右。默认 0dp，可调范围 -12–12dp。环外网络类型标签贴在读数外侧，会跟着一起移动。</string>

    <string name="out_signal_offset_y_title">环外信号垂直位置</string>
    <string name="out_signal_offset_y_summary">环外读数在状态栏里上下移动的距离，单位为 dp，正数向下。默认 0dp，可调范围 -12–12dp。只影响读数自己，不改变它的高度与占位。</string>

    <string name="value_centre_title">电量数字居中</string>
    <string name="value_centre_summary">电量数字放大到圆环中间并始终优先占据圆心。Wi-Fi 弧缩到顶部缺口，充电时改用小的闪电占用缺口（此时不画 Wi-Fi 弧），环内的网络类型也让位到缺口。</string>

    <string name="color_role_title">状态颜色</string>
    <string name="color_role_summary">分别为低电量、充电与危险电量指定颜色。</string>

    <string name="color_low_title">低电量颜色</string>
    <string name="color_charging_title">充电颜色</string>
    <string name="color_critical_title">危险电量颜色</string>
    <string name="color_field_summary">点按选择颜色</string>
    <string name="color_on_dark">深色背景</string>
    <string name="color_on_light">浅色背景</string>
    <string name="color_dialog_summary">分别设置状态栏为深色与浅色背景时使用的颜色。</string>
    <string name="color_reset">恢复默认</string>
    <string name="color_reset_summary">把三种状态颜色恢复为出厂预设。</string>
    <string name="color_reset_dialog_summary">三种状态颜色都会回到出厂预设，当前的自定义颜色会被覆盖。</string>
    <string name="color_reset_confirm">恢复</string>

    <string name="low_threshold_title">低电量阈值</string>
    <string name="low_threshold_summary">电量低于该值时切换到低电量颜色。</string>

    <string name="stroke_title">环线粗细</string>
    <string name="stroke_summary">电池圆环的描边宽度。</string>
    <string name="stroke_title_rect">电量条粗细</string>
    <string name="stroke_summary_rect">底部电量条的厚度。</string>

    <string name="arc_stroke_title">弧线粗细</string>
    <string name="arc_stroke_summary">Wi-Fi 弧线的描边宽度。</string>
    <string name="arc_stroke_summary_rect">Wi-Fi 弧线的描边宽度，同时决定这组弧线在顶部槽位里的纵向位置。</string>

    <string name="value_size_title">数字字号</string>
    <string name="value_size_summary">电量百分比文字的尺寸。</string>

    <string name="value_weight_title">数字字重</string>
    <string name="value_weight_summary">电量数字的笔画粗细，100 最细、900 最粗。</string>

    <string name="type_size_title">网络类型字号</string>
    <string name="type_size_summary">圆环中间 3G/4G/5G 等文字的大小。</string>

    <string name="out_type_size_title">环外网络类型字号</string>
    <string name="out_type_size_summary">状态栏中环外 3G/4G/5G 等文字的大小。这个标签由系统状态栏绘制，设置页里的预览格是它唯一的所见即所得参照。</string>

    <string name="out_type_margin_left_title">环外类型左边距</string>
    <string name="out_type_margin_left_summary">环外网络类型标签与其外侧（背对电池的一侧）之间的空隙，单位为 dp。默认 2dp，可调范围 0–16dp。RTL 语言下整行镜像，这条边距会跟着翻到另一侧。</string>

    <string name="out_type_margin_right_title">环外类型右边距</string>
    <string name="out_type_margin_right_summary">环外网络类型标签与其内侧（朝向电池与环外读数的一侧）之间的空隙，单位为 dp。默认 2dp，可调范围 0–16dp。RTL 语言下同样会镜像。</string>

    <string name="type_suffix_scale_title">5GA 中 A 的比例</string>
    <string name="type_suffix_scale_summary">网络类型以 A 结尾时（如 5GA），末尾的 A 相对主字号的百分比，底边与主字对齐。默认 65%%，可调范围 50–100%%；100%% 即不再缩小。环内与环外两处同时生效。</string>

    <string name="type_weight_title">网络类型字重</string>
    <string name="type_weight_summary">网络类型的笔画粗细，100 最细、900 最粗。</string>

    <string name="track_alpha_title">底纹浓度</string>
    <string name="track_alpha_summary">未点亮部分的透明度。</string>

    <string name="debug_title">调试日志</string>
    <string name="debug_summary">把详细过程写入 LSPosed 日志，排查问题时开启。</string>

